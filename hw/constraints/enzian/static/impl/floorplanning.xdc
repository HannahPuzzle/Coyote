resize_pblock [get_pblocks pblock_static] -add {CLOCKREGION_X5Y6:CLOCKREGION_X5Y8}
set_property SNAPPING_MODE NESTED [get_pblocks pblock_static]
set_property IS_SOFT TRUE [get_pblocks pblock_static]

create_pblock pblock_link2_rx
add_cells_to_pblock [get_pblocks pblock_link2_rx] [get_cells -quiet [list inst_static/inst_module_inst/i_eci_platform/i_eci_transport/rx_link2_il]]
resize_pblock [get_pblocks pblock_link2_rx] -add {CLOCKREGION_X5Y11:CLOCKREGION_X5Y11}
set_property IS_SOFT TRUE [get_pblocks pblock_link2_rx]

create_pblock pblock_link2_tx
