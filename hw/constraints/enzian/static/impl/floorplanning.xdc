resize_pblock [get_pblocks pblock_link2_tx] -add {SLICE_X112Y600:SLICE_X154Y629}
resize_pblock [get_pblocks pblock_link2_tx] -add {DSP48E2_X14Y240:DSP48E2_X17Y251}
resize_pblock [get_pblocks pblock_link2_tx] -add {IOB_X1Y520:IOB_X1Y545}
resize_pblock [get_pblocks pblock_link2_tx] -add {RAMB18_X8Y240:RAMB18_X10Y251}
resize_pblock [get_pblocks pblock_link2_tx] -add {RAMB36_X8Y120:RAMB36_X10Y125}
resize_pblock [get_pblocks pblock_link2_tx] -add {URAM288_X3Y160:URAM288_X3Y167}
